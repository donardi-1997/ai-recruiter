      ],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/ai-recruiter-cluster/ai-recruiter-api-c444",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
