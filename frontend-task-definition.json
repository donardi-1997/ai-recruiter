{
  "family": "ai-recruiter-frontend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::765761474007:role/ai-recruiter-ecs-execution-role",
  "containerDefinitions": [
    {
      "name": "ai-recruiter-frontend",
      "image": "765761474007.dkr.ecr.us-east-2.amazonaws.com/ai-recruiter-frontend:latest",
      "essential": true,
      "cpu": 512,
      "memory": 1024,
      "portMappings": [
        {
          "containerPort": 80,
          "hostPort": 80,
          "protocol": "tcp"
        }
      ],
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "us-east-2"
        },
        {
          "name": "API_URL",
          "value": "http://ai-recruiter-api-alb-184707625.us-east-2.elb.amazonaws.com"
        },
        {
          "name": "COGNITO_CLIENT_ID",
          "value": "buusqp2p10vb2nh8ft40i8imc"
        },
        {
          "name": "DEPLOYMENT_VERSION",
          "value": "2026-08-22-frontend-80"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/aws/ecs/ai-recruiter-cluster/ai-recruiter-frontend",
          "awslogs-region": "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
